{
  "expo": {
    "name": "MonkeyCode",
    "slug": "monkeycode",
    "version": "260608",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "monkeycode",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://monkeycode-ai.com/mobile/app/manifest",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.chaitin.baizhi.monkeycode",
      "buildNumber": "1",
      "icon": {
        "light": "./assets/icon.png",
        "dark": "./assets/icon-dark.png"
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "Used for voice input and live speech-to-text.",
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true,
          "NSAllowsLocalNetworking": true
        }
      },
      "appleTeamId": "8Z56KX83T3"
    },
    "android": {
      "package": "com.chaitin.baizhi.monkeycode",
      "versionCode": 1,
      "permissions": [
        "RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-apple-authentication",
      "expo-router",
      "expo-font",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/splash-dark.png",
            "backgroundColor": "#0b0b0e"
          }
        }
      ],
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Used to choose images as attachments for AI conversations."
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Used to save conversation images to your photo library.",
          "photosPermission": false,
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "./plugins/withAlipayLogin",
        {
          "scheme": "com.chaitin.baizhi.monkeycode.alipay",
          "androidSdkVersion": "15.8.42",
          "iosSdkVersion": "15.8.30"
        }
      ],
      "./plugins/withDouyinLogin",
      "./plugins/withAndroidFileSaver",
      [
        "expo-build-properties",
        {
          "ios": {
            "buildReactNativeFromSource": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "updatesServer": "https://release.monkeycode-ai.com/public/mobile",
      "alipayScheme": "com.chaitin.baizhi.monkeycode.alipay",
      "douyinClientKey": "awxdjorbktpeiqaj"
    }
  }
}
